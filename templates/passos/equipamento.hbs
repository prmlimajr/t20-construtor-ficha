<div class="cf-duas">
	<div class="cf-lista">
		<h4>Arma</h4>
		{{#each armas}}
		<p class="cf-subtitulo">{{titulo}}</p>
		<div class="cf-cards">
			{{#each cards}}
			<button type="button" class="cf-card {{#if selecionado}}selecionado{{/if}} {{#if foco}}foco{{/if}}"
				data-action="escolherEquip" data-campo="{{campo}}" data-valor="{{valor}}" data-nome="{{nome}}">
				<img src="{{img}}" alt="">
				<span class="cf-card-texto">
					<span class="cf-card-nome">{{nome}}</span>
					{{#if sub}}<span class="cf-card-sub">{{sub}}</span>{{/if}}
				</span>
			</button>
			{{/each}}
		</div>
		{{/each}}

		<h4>Armadura</h4>
		<div class="cf-cards">
			{{#each armaduras}}
			<button type="button" class="cf-card {{#if selecionado}}selecionado{{/if}} {{#if foco}}foco{{/if}}"
				data-action="escolherEquip" data-campo="{{campo}}" data-valor="{{valor}}" data-nome="{{nome}}">
				<img src="{{img}}" alt="">
				<span class="cf-card-texto">
					<span class="cf-card-nome">{{nome}}</span>
					{{#if sub}}<span class="cf-card-sub">{{sub}}</span>{{/if}}
				</span>
			</button>
			{{/each}}
		</div>

		{{#if escudo}}
		<h4>Escudo</h4>
		<div class="cf-cards">
			<button type="button" class="cf-card {{#if escudo.selecionado}}selecionado{{/if}} {{#if escudo.foco}}foco{{/if}}"
				data-action="escolherEquip" data-campo="{{escudo.campo}}" data-valor="{{escudo.valor}}" data-tipo="bool" data-nome="{{escudo.nome}}">
				<img src="{{escudo.img}}" alt="">
				<span class="cf-card-texto">
					<span class="cf-card-nome">{{escudo.nome}}</span>
					<span class="cf-card-sub">{{#if escudo.selecionado}}Levando{{else}}Clique para levar{{/if}}{{#if escudo.sub}} · {{escudo.sub}}{{/if}}</span>
				</span>
			</button>
		</div>
		{{/if}}

		{{#each itensClasse}}
		<h4>{{titulo}}</h4>
		<div class="cf-escolha-racial">
			{{#if ehItem}}
			<p class="cf-nota">{{texto}}</p>
			{{> "modules/t20-construtor-ficha/templates/partes/abrir.hbs" abrir}}
			{{/if}}
			{{#if ehPrototipo}}
			<div class="cf-chips">
				{{#each modos}}
				<button type="button" class="cf-chip {{#if selecionado}}selecionado{{/if}}" data-action="definir"
					data-campo="{{../campoModo}}" data-valor="{{valor}}">{{nome}}</button>
				{{/each}}
			</div>
			{{#if superior}}
			<p class="cf-nota">{{superior.texto}}</p>
			<div class="cf-campo"><span class="cf-rotulo-abrir">Item:</span> {{> "modules/t20-construtor-ficha/templates/partes/abrir.hbs" superior.item}}</div>
			{{#if superior.melhoria}}
			<div class="cf-campo"><span class="cf-rotulo-abrir">Melhoria:</span> {{> "modules/t20-construtor-ficha/templates/partes/abrir.hbs" superior.melhoria}}</div>
			{{/if}}
			{{/if}}
			{{#if alquimicos}}
			<p class="cf-nota">{{alquimicos.total}}</p>
			<div class="cf-cards">
				{{#each alquimicos.itens}}
				<div class="cf-card cf-alquimico {{#if qtd}}selecionado{{/if}}">
					<img src="{{img}}" alt="">
					<span class="cf-card-texto" data-action="focarEquip" data-nome="{{nome}}">
						<span class="cf-card-nome">{{nome}}{{#if qtd}} <small>×{{qtd}}</small>{{/if}}</span>
						<span class="cf-card-sub">{{preco}}</span>
					</span>
					<span class="cf-qtd">
						<button type="button" data-action="ajustarAlquimico" data-nome="{{nome}}" data-delta="-1" {{#unless podeMenos}}disabled{{/unless}} title="Remover"><i class="fa-solid fa-minus"></i></button>
						<button type="button" data-action="ajustarAlquimico" data-nome="{{nome}}" data-delta="1" {{#unless podeMais}}disabled{{/unless}} title="Adicionar"><i class="fa-solid fa-plus"></i></button>
					</span>
				</div>
				{{/each}}
			</div>
			{{/if}}
			{{/if}}
		</div>
		{{/each}}

		<h4>Itens que você já recebe</h4>
		{{#each recebidos}}
		<p class="cf-subtitulo">{{titulo}}</p>
		<div class="cf-cards">
			{{#each cards}}
			<button type="button" class="cf-card cf-card-fixo {{#if foco}}foco{{/if}}" data-action="focarEquip" data-nome="{{nome}}">
				<img src="{{img}}" alt="">
				<span class="cf-card-texto">
					<span class="cf-card-nome">{{nome}}{{#if qtd}} <small>×{{qtd}}</small>{{/if}}</span>
					{{#if sub}}<span class="cf-card-sub">{{sub}}</span>{{/if}}
				</span>
			</button>
			{{/each}}
		</div>
		{{/each}}
	</div>

	<aside class="cf-info">
		{{#if info}}
		<h3><img src="{{info.img}}" alt=""> {{info.nome}}</h3>
		{{#if info.stats.length}}
		<dl class="cf-dados">
			{{#each info.stats}}<dt>{{rotulo}}</dt><dd>{{valor}}</dd>{{/each}}
		</dl>
		{{/if}}
		{{#if info.descricao}}<div class="cf-descricao">{{{info.descricao}}}</div>{{/if}}
		{{else}}
		<p class="cf-vazio">Clique em um equipamento para ver os detalhes.</p>
		{{/if}}
	</aside>
</div>
