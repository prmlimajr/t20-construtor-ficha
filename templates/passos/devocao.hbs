{{#if obrigatoria}}
<p class="cf-aviso">{{motivo}}</p>
{{else if alternativa}}
<div class="cf-chips cf-bloco">
	<button type="button" class="cf-chip {{#if devoto}}selecionado{{/if}}" data-action="definir" data-campo="devoto" data-tipo="bool" data-valor="true">Devoto de um deus</button>
	<button type="button" class="cf-chip {{#if naoDevoto}}selecionado{{/if}}" data-action="definir" data-campo="devoto" data-tipo="bool" data-valor="false">{{alternativa.nome}}</button>
</div>
{{#if naoDevoto}}
<div class="cf-info cf-alternativa">
	<h3>{{alternativa.nome}}</h3>
	<p class="cf-lore">{{alternativa.descricao}}</p>
	{{#if alternativa.poder}}
	<h4>Você recebe</h4>
	{{> "modules/t20-construtor-ficha/templates/partes/poder.hbs" alternativa.poder aberto=true}}
	{{/if}}
</div>
{{else}}
<p class="cf-nota">{{alternativa.aviso}}</p>
{{/if}}
{{else}}
<div class="cf-chips cf-bloco">
	<button type="button" class="cf-chip {{#if devoto}}selecionado{{/if}}" data-action="definir" data-campo="devoto" data-tipo="bool" data-valor="true">Sim, é devoto</button>
	<button type="button" class="cf-chip {{#if naoDevoto}}selecionado{{/if}}" data-action="definir" data-campo="devoto" data-tipo="bool" data-valor="false">Não</button>
</div>
{{/if}}

{{#if devoto}}
<div class="cf-duas">
	<div class="cf-lista cf-lista-filtravel">
		<input type="search" class="cf-filtro cf-filtro-lista" data-filtro="divindade" placeholder="Buscar divindade…" value="{{filtro}}" aria-label="Buscar divindade pelo nome">
		{{#each gruposDivindades}}
		<section class="cf-grupo">
			<h4 class="cf-grupo-titulo">{{titulo}} <small>{{divindades.length}}</small></h4>
			<div class="cf-cards cf-cards-coluna cf-cards-texto">
				{{#each divindades}}
				{{#if bloqueado}}
				<button type="button" class="cf-card bloqueado" data-action="focarDivindade" data-valor="{{nome}}" data-busca="{{nome}} {{titulo}}" title="{{impedimento}}">
				{{else}}
				<button type="button" class="cf-card {{#if selecionado}}selecionado{{/if}}" data-action="definir" data-campo="divindade" data-valor="{{nome}}" data-busca="{{nome}} {{titulo}}">
				{{/if}}
					<span class="cf-card-texto">
						<span class="cf-card-nome">{{nome}}</span>
						<span class="cf-card-sub">{{titulo}}</span>
					</span>
				</button>
				{{/each}}
			</div>
		</section>
		{{/each}}
		<p class="cf-vazio cf-sem-resultado" hidden>Nenhuma divindade com esse nome.</p>
	</div>
	<aside class="cf-info">
		{{#if info}}
		<h3>{{info.nome}}</h3>
		<p class="cf-destaque">{{info.titulo}}</p>
		{{#if info.impedimento}}<p class="cf-aviso">{{info.impedimento}}</p>{{/if}}
		{{#if info.descricao}}<p class="cf-lore">{{info.descricao}}</p>
		<p class="cf-nota cf-direitos">Texto de Tormenta20 © Jambô Editora: uso pessoal, não compartilhe.</p>{{/if}}
		<dl class="cf-dados">
			{{#if info.crencas}}<dt>Crenças e objetivos</dt><dd>{{info.crencas}}</dd>{{/if}}
			{{#if info.simbolo}}<dt>Símbolo sagrado</dt><dd>{{info.simbolo}}</dd>{{/if}}
			{{#if info.energia}}<dt>Canalizar energia</dt><dd>{{info.energia}}</dd>{{/if}}
			{{#if info.arma}}<dt>Arma preferida</dt><dd>{{info.arma}}</dd>{{/if}}
			{{#if info.devotosTexto}}<dt>Devotos</dt><dd>{{info.devotosTexto}}</dd>{{/if}}
		</dl>
		{{#if info.obrigacoes}}
		<h4>Obrigações e restrições</h4>
		<p class="cf-obrigacoes">{{info.obrigacoes}}</p>
		{{/if}}

		{{#if info.escolhida}}
		<div class="cf-bloco cf-fundamentalista">
			<button type="button" class="cf-chip {{#if info.fundamentalista}}selecionado{{/if}}" data-action="definir" data-campo="fundamentalista"
				data-tipo="bool" data-valor="{{#if info.fundamentalista}}false{{else}}true{{/if}}" aria-pressed="{{#if info.fundamentalista}}true{{else}}false{{/if}}">
				<i class="fa-{{#if info.fundamentalista}}solid fa-square-check{{else}}regular fa-square{{/if}}"></i> Devoto fundamentalista
			</button>
			<p class="cf-nota">Um fundamentalista escolhe um poder concedido extra. A ficha registra a devoção como “{{info.nome}} (fundamentalista)”.</p>
		</div>
		<h4>Escolha {{info.qtd}} poder(es) concedido(s) <small>({{info.escolhidos}}/{{info.qtd}})</small></h4>
		{{else}}
		<h4>Poderes concedidos</h4>
		{{/if}}
		{{#each info.poderes}}
		{{#if ../info.escolhida}}
		{{> "modules/t20-construtor-ficha/templates/partes/poder-selecionavel.hbs" nome=nome img=info.img descricao=info.descricao selecionado=selecionado bloqueado=bloqueado motivo=motivo detalhe=motivo campo="poderesConcedidos" valor=nome limite=../info.qtd}}
		{{else}}
		{{> "modules/t20-construtor-ficha/templates/partes/poder-selecionavel.hbs" nome=nome img=info.img descricao=info.descricao}}
		{{/if}}
		{{/each}}
		{{else}}
		<p class="cf-vazio">Selecione uma divindade para ver seus dogmas e poderes concedidos.</p>
		{{/if}}
	</aside>
</div>
{{/if}}
