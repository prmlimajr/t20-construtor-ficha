<div class="cf-duas">
	<div class="cf-lista cf-lista-filtravel">
		<input type="search" class="cf-filtro cf-filtro-lista" data-filtro="classe" placeholder="Buscar classe…" value="{{filtro}}" aria-label="Buscar classe pelo nome">
		{{#each grupos}}
		<section class="cf-grupo">
			{{#if ../variosGrupos}}<h4 class="cf-grupo-titulo">{{titulo}} <small>{{classes.length}}</small></h4>{{/if}}
			<div class="cf-cards cf-cards-coluna">
				{{#each classes}}
				<button type="button" class="cf-card {{#if selecionado}}selecionado{{/if}}" data-action="definir" data-campo="classe" data-valor="{{uuid}}" data-busca="{{nome}}">
					<img src="{{img}}" alt="">
					<span class="cf-card-texto">
						<span class="cf-card-nome">{{nome}}</span>
						<span class="cf-card-sub">{{resumo}}</span>
					</span>
				</button>
				{{/each}}
			</div>
		</section>
		{{/each}}
		<p class="cf-vazio cf-sem-resultado" hidden>Nenhuma classe com esse nome.</p>
	</div>
	<aside class="cf-info">
		{{#if info}}
		<h3><img src="{{info.img}}" alt=""> {{info.nome}}</h3>
		{{#if info.fonte}}<p class="cf-fonte">{{info.fonte}} (Suplementos de Arton)</p>{{/if}}
		{{#if info.aviso}}<p class="cf-aviso"><i class="fa-solid fa-triangle-exclamation"></i> {{info.aviso}}</p>{{/if}}
		{{#if info.semRegras}}<p class="cf-aviso">Esta classe não tem regras cadastradas no construtor (data/classes.json).</p>{{/if}}
		<dl class="cf-dados">
			<dt>Pontos de vida</dt><dd>{{info.pv}}</dd>
			<dt>Pontos de mana</dt><dd>{{info.pm}}</dd>
			<dt>Perícias</dt><dd>{{info.pericias}}</dd>
			<dt>Proficiências</dt><dd>{{info.proficiencias}}</dd>
			{{#if info.magias}}<dt>Magias</dt><dd>{{info.magias}}</dd>{{/if}}
			{{#if info.devocao}}<dt>Devoção</dt><dd>{{info.devocao}}</dd>{{/if}}
		</dl>

		{{#each info.escolhas}}
		<div class="cf-bloco">
			<h4>{{titulo}}</h4>
			<div class="cf-chips">
				{{#each opcoes}}
				<button type="button" class="cf-chip {{#if selecionado}}selecionado{{/if}}" data-action="definir" data-campo="{{../campo}}" data-valor="{{valor}}">{{nome}}</button>
				{{/each}}
			</div>
			{{#each opcoes}}{{#if info}}{{> "modules/t20-construtor-ficha/templates/partes/poder-escolha.hbs" info aberto=true}}{{/if}}{{/each}}
		</div>
		{{/each}}

		<h4>Habilidades de 1º nível</h4>
		{{#each info.habilidades}}{{> "modules/t20-construtor-ficha/templates/partes/poder-escolha.hbs" this}}{{/each}}
		{{#if info.descricao}}
		<details class="cf-poder"><summary><span>Descrição da classe</span></summary><div class="cf-descricao">{{{info.descricao}}}</div></details>
		{{/if}}
		{{else}}
		<p class="cf-vazio">Selecione uma classe para ver o que ela é capaz de fazer.</p>
		{{/if}}
	</aside>
</div>
