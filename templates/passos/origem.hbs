{{#if semOrigens}}
<p class="cf-aviso">Nenhuma origem regional cadastrada ainda (data/origens-regionais.json). Este passo pode ser pulado.</p>
{{else}}
<div class="cf-duas">
	<div class="cf-lista cf-lista-filtravel">
		<input type="search" class="cf-filtro cf-filtro-lista" data-filtro="{{chaveFiltro}}" placeholder="Buscar origem…" value="{{filtro}}" aria-label="Buscar origem pelo nome">
		{{#each grupos}}
		<section class="cf-grupo">
			{{#if ../variosGrupos}}<h4 class="cf-grupo-titulo">{{titulo}} <small>{{origens.length}}</small></h4>{{/if}}
			<div class="cf-cards cf-cards-coluna cf-cards-texto">
				{{#each origens}}
				<button type="button" class="cf-card {{#if selecionado}}selecionado{{/if}}" data-action="definir" data-campo="{{../../campoNome}}" data-valor="{{nome}}" data-busca="{{nome}}">
					<span class="cf-card-texto">
						<span class="cf-card-nome">{{nome}}</span>
						<span class="cf-card-sub">{{resumo}}</span>
					</span>
				</button>
				{{/each}}
			</div>
		</section>
		{{/each}}
		<p class="cf-vazio cf-sem-resultado" hidden>Nenhuma origem com esse nome.</p>
	</div>
	<aside class="cf-info">
		{{#if info}}
		<h3>{{info.nome}}</h3>
		{{#if info.descricao}}<p class="cf-lore">{{info.descricao}}</p>{{/if}}

		<div class="cf-bloco">
			<h4>Itens</h4>
			{{#if info.itens.length}}
			<ul class="cf-itens">
				{{#each info.itens}}
				<li>
					{{#if campo}}
					<span class="cf-rotulo-abrir">{{rotulo}}:</span>
					{{> "modules/t20-construtor-ficha/templates/partes/abrir.hbs" this}}
					{{else}}{{texto}}{{/if}}
				</li>
				{{/each}}
			</ul>
			{{else}}<p class="cf-nota">Nenhum item.</p>{{/if}}
			{{#if info.tibares}}<p class="cf-nota"><i class="fa-solid fa-coins"></i> + T$ {{info.tibares}}, rolados junto com os tibares iniciais.</p>{{/if}}
		</div>

		{{#if info.mundana}}
		<div class="cf-bloco">
			<h4>Origem mundana</h4>
			<p class="cf-nota">Origem mundana ({{info.fonte}}): concede o poder abaixo, sem itens nem escolha de benefícios.</p>
			{{#if info.mundana.pericias.length}}
			<p><strong>Perícias treinadas:</strong> {{#each info.mundana.pericias}}<span class="cf-atr">{{atributo}}</span>{{nome}}{{#unless @last}}, {{/unless}}{{/each}}</p>
			{{/if}}
			{{#if info.mundana.oficios}}<p class="cf-nota"><i class="fa-solid fa-pen"></i> {{info.mundana.oficios}}: o sistema não tem esse Ofício como perícia; anote na ficha.</p>{{/if}}
			{{#if info.mundana.poder}}{{> "modules/t20-construtor-ficha/templates/partes/poder.hbs" info.mundana.poder}}{{/if}}
			{{#each info.mundana.extras}}{{> "modules/t20-construtor-ficha/templates/partes/poder.hbs" this}}{{/each}}
			{{#if info.mundana.escolhaPericia}}<div class="cf-campo"><span class="cf-rotulo-abrir">{{info.mundana.escolhaPericia.rotulo}}:</span> {{> "modules/t20-construtor-ficha/templates/partes/abrir.hbs" info.mundana.escolhaPericia}}</div>{{/if}}
			{{#if info.mundana.escolhaPoder}}<div class="cf-campo"><span class="cf-rotulo-abrir">{{info.mundana.escolhaPoder.rotulo}}:</span> {{> "modules/t20-construtor-ficha/templates/partes/abrir.hbs" info.mundana.escolhaPoder}}</div>{{/if}}
		</div>
		{{else if info.amnesico}}
		<div class="cf-bloco">
			<h4>Amnésico</h4>
			<p class="cf-nota">Você recebe Lembranças Graduais, uma perícia e um poder escolhidos pelo mestre.</p>
			{{> "modules/t20-construtor-ficha/templates/partes/poder.hbs" info.amnesico.lembrancas}}
			<div class="cf-campo"><span class="cf-rotulo-abrir">Perícia:</span> {{> "modules/t20-construtor-ficha/templates/partes/abrir.hbs" info.amnesico.pericia}}</div>
			<div class="cf-campo"><span class="cf-rotulo-abrir">Poder:</span> {{> "modules/t20-construtor-ficha/templates/partes/abrir.hbs" info.amnesico.poder}}</div>
		</div>
		{{else}}
		<div class="cf-bloco">
			<h4>Escolha {{info.rotuloBeneficios}} <small>({{info.escolhidos}}/{{info.qtdBeneficios}})</small></h4>
			{{#each info.beneficios}}
			{{> "modules/t20-construtor-ficha/templates/partes/poder-selecionavel.hbs" nome=nome rotulo=tipo atributo=atributo detalhe=detalhe img=info.img descricao=info.descricao grupo=grupo selecionado=selecionado bloqueado=bloqueado motivo="Já treinada" campo=../info.campoBeneficios valor=id limite=../info.qtdBeneficios}}
			{{/each}}
		</div>
		{{/if}}
		{{else}}
		<p class="cf-vazio">Selecione uma origem para ver o que ela fornece.</p>
		{{/if}}
	</aside>
</div>
{{/if}}
