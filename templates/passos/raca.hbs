<div class="cf-duas">
	<div class="cf-lista cf-cards">
		{{#each racas}}
		<button type="button" class="cf-card {{#if selecionado}}selecionado{{/if}}" data-action="definir" data-campo="raca" data-valor="{{uuid}}">
			<img src="{{img}}" alt="">
			<span class="cf-card-texto">
				<span class="cf-card-nome">{{nome}}</span>
				<span class="cf-card-sub">{{resumo}}</span>
				{{#if fonte}}<span class="cf-fonte">{{fonte}}</span>{{/if}}
			</span>
		</button>
		{{/each}}
	</div>
	<aside class="cf-info">
		{{#if info}}
		<h3><img src="{{info.img}}" alt=""> {{info.nome}}</h3>
		{{#if info.fonte}}<p class="cf-fonte">{{info.fonte}} (Suplementos de Arton)</p>{{/if}}
		<p class="cf-destaque"><strong>Atributos:</strong> {{info.atributos}}</p>
		{{#if info.dinamicos}}
		<div class="cf-bloco">
			<h4>Escolha {{info.qtdDinamicos}} atributos para receber +1</h4>
			{{#if info.dinamicosDeduzidos}}<p class="cf-nota"><i class="fa-solid fa-circle-info"></i> Regra deduzida do texto do suplemento; confira com o livro.</p>{{/if}}
			<div class="cf-chips">
				{{#each info.dinamicos}}
				<button type="button" class="cf-chip {{#if selecionado}}selecionado{{/if}}" data-action="alternar"
					data-campo="racaAtributos" data-valor="{{chave}}" data-limite="{{../info.qtdDinamicos}}">{{nome}}</button>
				{{/each}}
			</div>
		</div>
		{{/if}}
		{{#if info.descricao}}<div class="cf-descricao">{{{info.descricao}}}</div>{{/if}}
		<h4>Habilidades raciais</h4>
		{{#each info.poderes}}
		{{> "modules/t20-construtor-ficha/templates/partes/poder.hbs" this}}
		{{#if magiasFixas}}<p class="cf-nota cf-magias-fixas"><i class="fa-solid fa-wand-sparkles"></i> Magia na ficha: {{magiasFixas}}</p>{{/if}}
		{{#if escolha}}{{> "modules/t20-construtor-ficha/templates/partes/escolha-racial.hbs" escolha}}{{/if}}
		{{/each}}
		{{#if info.semOrigem}}<p class="cf-nota"><i class="fa-solid fa-circle-info"></i> Esta raça não escolhe origem: o passo Origem é pulado.</p>{{/if}}
		{{else}}
		<p class="cf-vazio">Selecione uma raça para ver o que ela fornece.</p>
		{{/if}}
	</aside>
</div>
