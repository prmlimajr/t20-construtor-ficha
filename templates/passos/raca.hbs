<div class="cf-duas">
	<div class="cf-lista cf-lista-filtravel">
		<input type="search" class="cf-filtro cf-filtro-lista" data-filtro="raca" placeholder="Buscar raça…" value="{{filtro}}" aria-label="Buscar raça pelo nome">
		{{#each grupos}}
		<section class="cf-grupo">
			{{#if ../variosGrupos}}<h4 class="cf-grupo-titulo">{{titulo}} <small>{{racas.length}}</small></h4>{{/if}}
			<div class="cf-cards cf-cards-coluna">
				{{#each racas}}
				<button type="button" class="cf-card {{#if selecionado}}selecionado{{/if}}" data-action="definir" data-campo="raca" data-valor="{{uuid}}" data-busca="{{nome}}">
					<img src="{{img}}" alt="">
					<span class="cf-card-texto">
						<span class="cf-card-nome">{{nome}}</span>
						<span class="cf-card-sub">{{resumo}}</span>
					</span>
				</button>
				{{/each}}
			</div>
		</section>
		{{/each}}
		<p class="cf-vazio cf-sem-resultado" hidden>Nenhuma raça com esse nome.</p>
	</div>
	<aside class="cf-info">
		{{#if info}}
		<h3><img src="{{info.img}}" alt=""> {{info.nome}}</h3>
		{{#if info.fonte}}<p class="cf-fonte">{{info.fonte}}{{#if info.doSuplemento}} (Suplementos de Arton){{/if}}</p>{{/if}}
		<p class="cf-destaque"><strong>Atributos:</strong> {{info.atributos}}</p>
		{{#if info.abertos}}
		<div class="cf-bloco cf-racas-abertas">
			<h4>Distribua os modificadores da raça <small>({{info.abertos.feitos}}/{{info.abertos.total}})</small></h4>
			<p class="cf-nota"><i class="fa-solid fa-circle-info"></i> Raças abertas (regra opcional do sistema): cada modificador vai para o atributo que você quiser, no máximo um por atributo.</p>
			{{#each info.abertos.linhas}}
			<div class="cf-aberto-linha">
				<span class="cf-aberto-valor {{#if negativo}}negativo{{/if}}">{{valor}}</span>
				<div class="cf-chips">
					{{#each atributos}}
					<button type="button" class="cf-chip {{#if selecionado}}selecionado{{/if}}" data-action="atribuirAberto"
						data-indice="{{../indice}}" data-valor="{{chave}}" {{#if bloqueado}}disabled title="Já recebeu outro modificador"{{/if}}>{{nome}}</button>
					{{/each}}
				</div>
			</div>
			{{/each}}
		</div>
		{{/if}}
		{{#if info.dinamicos}}
		<div class="cf-bloco">
			<h4>Escolha {{info.qtdDinamicos}} atributos para receber +1</h4>
			{{#if info.dinamicosDeduzidos}}<p class="cf-nota"><i class="fa-solid fa-circle-info"></i> Regra deduzida do texto do suplemento; confira com o livro.</p>{{/if}}
			<div class="cf-chips">
				{{#each info.dinamicos}}
				<button type="button" class="cf-chip {{#if selecionado}}selecionado{{/if}}" data-action="alternar"
					data-campo="racaAtributos" data-valor="{{chave}}" data-limite="{{../info.qtdDinamicos}}">{{nome}}</button>
				{{/each}}
			</div>
		</div>
		{{/if}}
		{{#if info.descricao}}<div class="cf-descricao">{{{info.descricao}}}</div>{{/if}}
		<h4>Habilidades raciais</h4>
		{{#each info.poderes}}
		{{#if escolhaDaRaca}}<h4 class="cf-escolha-raca-titulo">{{nome}}</h4>{{else}}{{> "modules/t20-construtor-ficha/templates/partes/poder.hbs" this}}{{/if}}
		{{#if magiasFixas}}<p class="cf-nota cf-magias-fixas"><i class="fa-solid fa-wand-sparkles"></i> Magia na ficha: {{magiasFixas}}</p>{{/if}}
		{{#if escolha}}{{> "modules/t20-construtor-ficha/templates/partes/escolha-racial.hbs" escolha}}{{/if}}
		{{/each}}
		{{#if info.semOrigem}}<p class="cf-nota"><i class="fa-solid fa-circle-info"></i> Esta raça não escolhe origem: o passo Origem é pulado.</p>{{/if}}
		{{else}}
		<p class="cf-vazio">Selecione uma raça para ver o que ela fornece.</p>
		{{/if}}
	</aside>
</div>
