<div class="cf-duas">
	<div class="cf-lista">
		{{#if escolas}}
		<h4>Escolas de magia <small>({{escolasEscolhidas}}/{{qtdEscolas}})</small></h4>
		<div class="cf-cards">
			{{#each escolas}}
			<button type="button" class="cf-card {{#if selecionado}}selecionado{{/if}} {{#if foco}}foco{{/if}} {{#if vazia}}bloqueado{{/if}}"
				data-action="focarEscola" data-valor="{{chave}}">
				<span class="cf-sigla">{{sigla}}</span>
				<span class="cf-card-texto">
					<span class="cf-card-nome">{{nome}}</span>
					<span class="cf-card-sub">{{#if vazia}}Nenhuma magia para sua classe{{else}}{{qtdMagias}} magias de 1º círculo{{/if}}</span>
				</span>
			</button>
			{{/each}}
		</div>
		{{/if}}

		<h4>Magias conhecidas <small>({{qtdEscolhidas}}/{{qtd}})</small></h4>
		{{#if todas}}<p class="cf-nota"><i class="fa-solid fa-circle-info"></i> Você não aprende magias: com Usurpar, pode lançar qualquer magia divina dos círculos a que tem acesso. Todas as magias divinas de 1º círculo vão para a ficha.</p>{{/if}}
		{{#if precisaEscolas}}
		<p class="cf-nota">Escolha {{qtdEscolas}} escolas para liberar as magias.</p>
		{{else}}
		<div class="cf-cards">
			{{#each escolhidas}}
			<button type="button" class="cf-card selecionado {{#if foco}}foco{{/if}}" data-action="focarMagia" data-uuid="{{uuid}}">
				<img src="{{img}}" alt="">
				<span class="cf-card-texto">
					<span class="cf-card-nome">{{nome}}</span>
					<span class="cf-card-sub">{{sub}}</span>
				</span>
			</button>
			{{/each}}
			{{#each vagas}}
			<button type="button" class="cf-card cf-vaga" data-action="abrirSlideout" data-campo="magias" data-lista="magia"
				data-titulo="Escolha uma magia de 1º círculo" data-limite="{{../qtd}}">
				<span class="cf-sigla"><i class="fa-solid fa-plus"></i></span>
				<span class="cf-card-texto"><span class="cf-card-nome">Escolher magia</span></span>
			</button>
			{{/each}}
		</div>
		{{/if}}
	</div>

	<aside class="cf-info">
		{{#if infoEscola}}
		<h3>{{infoEscola.nome}} <small>({{infoEscola.sigla}})</small></h3>
		<p class="cf-lore">{{infoEscola.descricao}}</p>
		{{#if infoEscola.podeEscolher}}
		<button type="button" class="{{#unless infoEscola.selecionado}}cf-primario{{/unless}} cf-escolher" data-action="alternar"
			data-campo="magiasEscolas" data-valor="{{infoEscola.chave}}" data-limite="{{qtdEscolas}}">
			{{#if infoEscola.selecionado}}<i class="fa-solid fa-xmark"></i> Remover escola{{else}}<i class="fa-solid fa-check"></i> Escolher escola{{/if}}
		</button>
		{{else}}
		<p class="cf-aviso">{{infoEscola.motivo}}</p>
		{{/if}}
		{{#if infoEscola.magias.length}}
		<h4>Magias desta escola</h4>
		<div class="cf-cards">
			{{#each infoEscola.magias}}
			<button type="button" class="cf-card" data-action="focarMagia" data-uuid="{{uuid}}">
				<img src="{{img}}" alt=""><span class="cf-card-texto"><span class="cf-card-nome">{{nome}}</span></span>
			</button>
			{{/each}}
		</div>
		{{/if}}

		{{else if infoMagia}}
		<h3><img src="{{infoMagia.img}}" alt=""> {{infoMagia.nome}}</h3>
		<p class="cf-destaque">{{infoMagia.escola}} · {{infoMagia.tipo}} · 1º círculo</p>
		{{#if infoMagia.selecionado}}
		<button type="button" class="cf-escolher" data-action="alternar" data-campo="magias" data-valor="{{infoMagia.uuid}}" data-limite="{{qtd}}">
			<i class="fa-solid fa-xmark"></i> Remover magia
		</button>
		{{/if}}
		{{#if infoMagia.escolaDescricao}}<p class="cf-nota">{{infoMagia.escolaDescricao}}</p>{{/if}}
		{{#if infoMagia.stats.length}}
		<dl class="cf-dados">{{#each infoMagia.stats}}<dt>{{rotulo}}</dt><dd>{{valor}}</dd>{{/each}}</dl>
		{{/if}}
		<div class="cf-descricao">{{{infoMagia.descricao}}}</div>
		{{> "modules/t20-construtor-ficha/templates/partes/aprimoramentos.hbs" infoMagia}}

		{{else}}
		<p class="cf-vazio">{{#if escolas}}Clique em uma escola para ver a descrição e escolhê-la. {{/if}}Use “Escolher magia” para abrir a lista de magias disponíveis.</p>
		{{/if}}
	</aside>
</div>
