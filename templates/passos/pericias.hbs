<div class="cf-duas">
	<div class="cf-lista">
		{{#if daRaca.length}}
		<h4>Treinadas pela raça</h4>
		<div class="cf-cards">
			{{#each daRaca}}
			<button type="button" class="cf-card selecionado cf-card-fixo {{#if foco}}foco{{/if}}" data-action="focarPericia" data-valor="{{chave}}">
				<span class="cf-sigla">{{atributo}}</span>
				<span class="cf-card-texto">
					<span class="cf-card-nome">{{nome}}</span>
					{{#if tags}}<span class="cf-card-sub">{{tags}}</span>{{/if}}
				</span>
			</button>
			{{/each}}
		</div>
		{{#if repetidas}}
		<p class="cf-nota"><i class="fa-solid fa-triangle-exclamation"></i> {{repetidas}} já é treinada pela classe. Volte ao passo Raça se quiser trocar por outra perícia.</p>
		{{/if}}
		{{/if}}

		{{#unless manuais}}
		<h4>Treinadas pela classe</h4>
		<div class="cf-cards">
			{{#each fixas}}
			<button type="button" class="cf-card selecionado cf-card-fixo {{#if foco}}foco{{/if}}" data-action="focarPericia" data-valor="{{chave}}">
				<span class="cf-sigla">{{atributo}}</span>
				<span class="cf-card-texto">
					<span class="cf-card-nome">{{nome}}</span>
					{{#if tags}}<span class="cf-card-sub">{{tags}}</span>{{/if}}
				</span>
			</button>
			{{/each}}
		</div>
		{{/unless}}

		{{#each secoes}}
		<h4>{{titulo}} <small>({{contagem}})</small></h4>
		{{#if nota}}<p class="cf-nota">{{nota}}</p>{{/if}}
		<div class="cf-cards">
			{{#each escolhidas}}
			<button type="button" class="cf-card selecionado {{#if foco}}foco{{/if}}" data-action="focarPericia" data-valor="{{chave}}" data-campo="{{campo}}">
				<span class="cf-sigla">{{atributo}}</span>
				<span class="cf-card-texto">
					<span class="cf-card-nome">{{nome}}</span>
					{{#if tags}}<span class="cf-card-sub">{{tags}}</span>{{/if}}
				</span>
			</button>
			{{/each}}
			{{#each vagas}}
			<button type="button" class="cf-card cf-vaga" data-action="abrirSlideout" data-campo="{{../campo}}" data-lista="{{../lista}}"
				data-titulo="{{../tituloSlideout}}" data-limite="{{../limite}}">
				<span class="cf-sigla"><i class="fa-solid fa-plus"></i></span>
				<span class="cf-card-texto"><span class="cf-card-nome">Escolher perícia</span></span>
			</button>
			{{/each}}
		</div>
		{{#if semOpcoes}}<p class="cf-nota"><i class="fa-solid fa-triangle-exclamation"></i> Não há mais perícias para escolher aqui: todas as opções já são treinadas.</p>{{/if}}
		{{/each}}
	</div>

	<aside class="cf-info">
		{{#if info}}
		<h3>{{info.nome}}</h3>
		{{#if info.campo}}
		<button type="button" class="cf-escolher" data-action="removerPericia" data-campo="{{info.campo}}" data-valor="{{info.chave}}">
			<i class="fa-solid fa-xmark"></i> Remover perícia
		</button>
		{{/if}}
		<dl class="cf-dados">
			<dt>Atributo</dt><dd>{{info.atributo}}</dd>
			<dt>Somente treinado</dt><dd>{{#if info.somenteTreinado}}Sim{{else}}Não{{/if}}</dd>
			<dt>Penalidade de armadura</dt><dd>{{#if info.penalidade}}Sim{{else}}Não{{/if}}</dd>
			<dt>Situação</dt><dd>{{#if info.treinada}}Treinada{{else}}Não treinada{{/if}}</dd>
		</dl>
		{{#if info.descricao}}<div class="cf-descricao">{{{info.descricao}}}</div>{{/if}}
		{{else}}
		<p class="cf-vazio">Use “Escolher perícia” para abrir a lista das perícias disponíveis. Clique numa perícia para ver os detalhes.</p>
		{{/if}}
	</aside>
</div>
