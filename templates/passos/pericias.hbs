<div class="cf-bloco">
	<h4>Perícias da classe</h4>
	<p>Você é treinado em: <strong>{{fixas}}</strong></p>
	{{#each grupos}}
	<label class="cf-campo">Escolha uma:
		<select data-campo="{{campo}}">
			<option value="">—</option>
			{{#each opcoes}}<option value="{{chave}}" {{#if selecionado}}selected{{/if}}>{{nome}}</option>{{/each}}
		</select>
	</label>
	{{/each}}
</div>

<div class="cf-bloco">
	<h4>Escolha {{numeroClasse}} perícias da classe <small>({{escolhidasClasse}}/{{numeroClasse}})</small></h4>
	<div class="cf-chips">
		{{#each opcoesClasse}}
		<button type="button" class="cf-chip {{#if selecionado}}selecionado{{/if}}" data-action="alternar" data-campo="periciasClasse" data-valor="{{chave}}" data-limite="{{../numeroClasse}}" {{#if bloqueado}}disabled title="Já treinada"{{/if}}>{{nome}}</button>
		{{/each}}
	</div>
</div>

<div class="cf-bloco">
	<h4>Perícias por Inteligência <small>(Int {{intTotal}} → {{nInt}}; {{escolhidasInt}}/{{nInt}})</small></h4>
	{{#if nInt}}
	<p class="cf-nota">Você pode escolher qualquer perícia.</p>
	<div class="cf-chips">
		{{#each opcoesInt}}
		<button type="button" class="cf-chip {{#if selecionado}}selecionado{{/if}}" data-action="alternar" data-campo="periciasInt" data-valor="{{chave}}" data-limite="{{../nInt}}" {{#if bloqueado}}disabled title="Já treinada"{{/if}}>{{nome}}</button>
		{{/each}}
	</div>
	{{else}}
	<p class="cf-nota">Sua Inteligência não concede perícias adicionais.</p>
	{{/if}}
</div>
