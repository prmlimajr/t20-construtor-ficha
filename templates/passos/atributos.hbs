{{#if variosModos}}
<div class="cf-bloco">
	<h4>Modalidade</h4>
	<div class="cf-chips">
		{{#each modos}}
		<button type="button" class="cf-chip {{#if selecionado}}selecionado{{/if}}" data-action="definir" data-campo="atrModo" data-valor="{{id}}">{{nome}}</button>
		{{/each}}
	</div>
</div>
{{/if}}

{{#if variado}}
<div class="cf-bloco cf-variado">
	<h4>{{variado.nome}}</h4>
	<p class="cf-nota">{{variado.descricao}}</p>
	{{#if variado.emOrdem}}<p class="cf-nota"><i class="fa-solid fa-lock"></i> Em ordem (configuração do mestre): a 1ª rolagem é Força, a 2ª Destreza e assim por diante; os valores não podem ser trocados.</p>{{/if}}
	{{#if variado.rolavel}}
	{{#unless variado.rolado}}
	<p class="cf-nota">O resultado vai para o chat e só pode ser rolado uma vez.</p>
	<button type="button" class="cf-primario" data-action="rolarVariado"><i class="fa-solid fa-dice"></i> {{variado.botao}}</button>
	{{/unless}}
	{{/if}}
	{{#if variado.brutos}}<p class="cf-nota">{{variado.brutos}}</p>{{/if}}
</div>
{{/if}}

{{#if ehPontos}}
<div class="cf-placar {{#if estourou}}erro{{/if}}">
	<span>Pontos gastos <strong>{{gastos}}</strong> de
		<input type="number" class="cf-pontos-total" data-campo="atrPontosTotal" data-tipo="numero" value="{{pontosTotais}}" min="0" max="50" step="1" title="Total de pontos (padrão 10)">
	</span>
	<span>Restantes <strong>{{restantes}}</strong></span>
</div>
<p class="cf-nota">O padrão do livro é 10 pontos; altere o total se a mesa usar outro valor. Todos começam em 0. Custo: −1 devolve 1 ponto · 1 custa 1 · 2 custa 2 · 3 custa 4 · 4 custa 7.</p>
{{/if}}

{{#if ehRolagem}}
<div class="cf-bloco">
	{{#if rolagem}}
	<p class="cf-nota">Soma dos atributos: {{rolagem.soma}}.
		{{#if rolagem.podeRerrolar}}Como a soma é menor que +6, você pode rolar novamente o menor valor.{{/if}}</p>
	{{#if rolagem.podeRerrolar}}
	<button type="button" data-action="rerrolarMenor"><i class="fa-solid fa-dice"></i> Rolar novamente o menor</button>
	{{/if}}
	{{else}}
	<p class="cf-nota">Role 4d6 seis vezes, descartando o menor dado de cada rolagem. O resultado vai para o chat e só pode ser rolado uma vez.</p>
	<button type="button" class="cf-primario" data-action="rolarAtributos"><i class="fa-solid fa-dice"></i> Rolar atributos</button>
	{{/if}}
</div>
{{/if}}

{{#if ehFixo}}
<div class="cf-bloco">
	<h4>Arranjo</h4>
	<div class="cf-chips">
		{{#each arranjos}}
		<button type="button" class="cf-chip {{#if selecionado}}selecionado{{/if}}" data-action="definir" data-campo="atrFixo.arranjo" data-tipo="numero" data-valor="{{indice}}">{{texto}}</button>
		{{/each}}
	</div>
</div>
{{/if}}

{{#if dnd}}
<div class="cf-dnd">
	<div class="cf-monte {{#if poolVazio}}vazio{{/if}}" data-soltar="" data-action="colocarDado">
		{{#each pool}}
		<div class="cf-dado {{#if selecionado}}selecionado{{/if}}" draggable="true" data-dado="{{indice}}" data-action="selecionarDado"
			title="Arraste até um atributo (ou clique aqui e depois no atributo)">
			{{#if bruto}}<small>{{bruto}}</small>{{/if}}<strong>{{valor}}</strong>
		</div>
		{{else}}
		<span class="cf-nota">Todos os valores foram distribuídos. Arraste um valor de volta para cá para removê-lo.</span>
		{{/each}}
	</div>
	{{#if ehValkaria}}
	<p class="cf-nota">Arraste cada dado até um atributo (vários dados podem ir no mesmo). Arraste de volta para cá para tirar.</p>
	{{else}}
	<p class="cf-nota">Arraste cada valor até um atributo. Soltar sobre um atributo já preenchido troca os valores.</p>
	{{/if}}
</div>
{{/if}}

{{#if modo}}
<table class="cf-tabela-atributos {{#if dnd}}cf-dnd{{/if}}">
	<thead><tr><th>Atributo</th><th>Base</th><th>Raça</th>{{#if colunaIdade}}<th title="{{nomeFaixa}}">Idade</th>{{/if}}<th>Total</th></tr></thead>
	<tbody>
		{{#each linhas}}
		<tr>
			<td>{{nome}}</td>
			<td class="cf-base">
				{{#if ../ehPontos}}
				<button type="button" class="cf-mini" data-action="ajustarPonto" data-atributo="{{chave}}" data-delta="-1" {{#unless podeDiminuir}}disabled{{/unless}}>−</button>
				<strong>{{base}}</strong>
				<button type="button" class="cf-mini" data-action="ajustarPonto" data-atributo="{{chave}}" data-delta="1" {{#unless podeAumentar}}disabled{{/unless}}>+</button>
				<small>({{custo}} pts)</small>
				{{else if dnd}}
				<div class="cf-slot {{#if alvo}}alvo{{/if}}" data-soltar="{{chave}}" data-action="colocarDado">
					{{#if slot}}
					<div class="cf-dado {{#if slot.selecionado}}selecionado{{/if}}" draggable="true" data-dado="{{slot.indice}}" data-action="selecionarDado">
						{{#if slot.bruto}}<small>{{slot.bruto}}</small>{{/if}}<strong>{{slot.valor}}</strong>
					</div>
					{{else}}<span class="cf-slot-vazio">solte aqui</span>{{/if}}
				</div>
				{{else if valkaria}}
				<div class="cf-slot cf-slot-multi {{#if valkaria.alvo}}alvo{{/if}}" data-soltar="{{chave}}" data-action="colocarDado">
					{{#each valkaria.dados}}
					<div class="cf-dado {{#if selecionado}}selecionado{{/if}}" draggable="true" data-dado="{{indice}}" data-action="selecionarDado"><strong>{{valor}}</strong></div>
					{{/each}}
					<small class="cf-valkaria-conta">{{valkaria.conta}} → <strong>{{base}}</strong></small>
				</div>
				{{else}}<strong>{{base}}</strong>{{/if}}
			</td>
			<td>{{racial}}</td>
			{{#if ../colunaIdade}}<td>{{idade}}</td>{{/if}}
			<td class="cf-total">{{total}}</td>
		</tr>
		{{/each}}
	</tbody>
</table>
{{/if}}
