{{#if carregando}}
<div class="cf-carregando" role="status" aria-live="polite">
	{{#if erro}}
	<i class="fa-solid fa-triangle-exclamation"></i>
	<p>Não foi possível carregar os dados do construtor.</p>
	<p class="cf-nota">{{erro}}</p>
	<button type="button" class="cf-primario" data-action="tentarDeNovo"><i class="fa-solid fa-rotate-right"></i> Tentar de novo</button>
	{{else}}
	<i class="fa-solid fa-hat-wizard cf-carregando-icone"></i>
	<p>Preparando o construtor…</p>
	<p class="cf-nota">Carregando raças, classes, poderes, magias e equipamentos dos compêndios. Só na primeira abertura.</p>
	<div class="cf-carregando-barra"><span></span></div>
	{{/if}}
</div>
{{else}}
<div class="cf-layout">
	<nav class="cf-lateral">
		<img class="cf-logo" src="modules/t20-construtor-ficha/assets/logo.webp" alt="Tormenta 20"
			onerror="if (!this.dataset.png) { this.dataset.png = 1; this.src = this.src.replace(/\.webp$/, '.png'); } else { this.remove(); }">
		<ol class="cf-passos">
			{{#each passos}}
			<li>
				<button type="button" class="cf-passo {{#if atual}}atual{{/if}} {{#if feito}}feito{{/if}}"
					data-action="irPara" data-indice="{{indice}}" {{#unless acessivel}}disabled{{/unless}}>
					<span class="cf-num">{{#if feito}}<i class="fa-solid fa-check"></i>{{else}}{{numero}}{{/if}}</span>
					<span>{{titulo}}</span>
				</button>
			</li>
			{{/each}}
		</ol>
		<div class="cf-resumo">
			{{#each resumoLateral.linhas}}
			<div class="cf-resumo-linha"><span>{{rotulo}}</span><strong>{{valor}}</strong></div>
			{{/each}}
			{{#if resumoLateral.atributos}}
			<div class="cf-resumo-atributos">
				{{#each resumoLateral.atributos}}
				<div><small>{{sigla}}</small><strong>{{valor}}</strong></div>
				{{/each}}
			</div>
			{{/if}}
		</div>
		<button type="button" class="cf-recomecar" data-action="recomecar">
			<i class="fa-solid fa-rotate-left"></i> Recomeçar
		</button>
	</nav>

	<section class="cf-principal">
		<header class="cf-cabecalho">
			<div class="cf-cabecalho-texto">
				<h2>{{passo.titulo}}</h2>
				<p>{{passo.dica}}</p>
			</div>
			{{#if venda.podeVender}}
			<button type="button" class="cf-primario cf-cabecalho-acao" data-action="abrirVenda"
				{{#if venda.bloqueado}}disabled title="Escolha todo o seu equipamento antes de vender"{{/if}}>
				<i class="fa-solid fa-hand-holding-dollar"></i> Vender itens</button>
			{{/if}}
		</header>

		<div class="cf-conteudo">
			{{> (lookup passo "template") }}
		</div>

		<footer class="cf-rodape">
			<span class="cf-pendencia {{#unless pendencia}}ok{{/unless}}">
				{{#if pendencia}}<i class="fa-solid fa-circle-exclamation"></i> {{pendencia}}
				{{else}}<i class="fa-solid fa-circle-check"></i> Tudo certo neste passo.{{/if}}
			</span>
			<button type="button" data-action="voltar" {{#if primeiro}}disabled{{/if}}>
				<i class="fa-solid fa-arrow-left"></i> Voltar
			</button>
			{{#if ultimo}}
			<button type="button" class="cf-primario" data-action="finalizar" {{#if pendencia}}disabled{{/if}}>
				<i class="fa-solid fa-flag-checkered"></i> Criar personagem
			</button>
			{{else}}
			<button type="button" class="cf-primario" data-action="avancar" {{#if pendencia}}disabled{{/if}}>
				Avançar <i class="fa-solid fa-arrow-right"></i>
			</button>
			{{/if}}
		</footer>

		{{#if slideout}}
		<div class="cf-slideout-fundo" data-action="fecharSlideout"></div>
		<div class="cf-slideout {{#if slideout.animar}}animar{{/if}}" tabindex="-1">
			<header class="cf-slideout-cabecalho">
				<button type="button" class="cf-slideout-fechar" data-action="fecharSlideout" title="Fechar (Esc)">
					<i class="fa-solid fa-arrow-right"></i>
				</button>
				<h3>{{slideout.titulo}}</h3>
				{{#if slideout.longa}}
				<input type="search" class="cf-filtro" placeholder="Filtrar…" value="{{slideout.filtro}}">
				{{/if}}
				{{#if slideout.indisponiveis}}
				<button type="button" class="cf-chip {{#if slideout.mostrarIndisponiveis}}selecionado{{/if}}" data-action="alternarIndisponiveisSlideout"
					title="Poderes cujo pré-requisito o personagem não atende">
					<i class="fa-solid fa-eye{{#unless slideout.mostrarIndisponiveis}}-slash{{/unless}}"></i> Indisponíveis ({{slideout.indisponiveis}})
				</button>
				{{/if}}
			</header>
			{{#if slideout.venda}}
			{{> "modules/t20-construtor-ficha/templates/partes/venda.hbs" slideout}}
			{{else}}
			<div class="cf-duas">
				{{#if slideout.grupos}}
				<div class="cf-lista">
					{{#each slideout.grupos}}
					<section class="cf-grupo">
						<h4 class="cf-grupo-titulo">{{titulo}} <small>{{cards.length}}</small></h4>
						<div class="cf-cards cf-cards-coluna">
							{{#each cards}}
							<button type="button" class="cf-card {{#if selecionado}}selecionado{{/if}} {{#if foco}}foco{{/if}} {{#if indisponivel}}bloqueado{{/if}}"
								data-action="focarSlideout" data-valor="{{valor}}" data-busca="{{nome}} {{sub}} {{../titulo}}" {{#if indisponivel}}{{#unless selecionado}}disabled{{/unless}}{{/if}}>
								{{#if img}}<img src="{{img}}" alt="">{{else if sigla}}<span class="cf-sigla">{{sigla}}</span>{{/if}}
								<span class="cf-card-texto">
									<span class="cf-card-nome">{{nome}}</span>
									{{#if sub}}<span class="cf-card-sub">{{sub}}</span>{{/if}}
								</span>
							</button>
							{{/each}}
						</div>
					</section>
					{{/each}}
				</div>
				{{else}}
				<div class="cf-lista cf-cards">
					{{#each slideout.cards}}
					<button type="button" class="cf-card {{#if selecionado}}selecionado{{/if}} {{#if foco}}foco{{/if}} {{#if indisponivel}}bloqueado{{/if}}"
						data-action="focarSlideout" data-valor="{{valor}}" data-busca="{{nome}} {{sub}}" {{#if indisponivel}}{{#unless selecionado}}disabled{{/unless}}{{/if}}>
						{{#if img}}<img src="{{img}}" alt="">{{else if sigla}}<span class="cf-sigla">{{sigla}}</span>{{/if}}
						<span class="cf-card-texto">
							<span class="cf-card-nome">{{nome}}</span>
							{{#if sub}}<span class="cf-card-sub">{{sub}}</span>{{/if}}
						</span>
					</button>
					{{/each}}
				</div>
				{{/if}}
				<aside class="cf-info">
					{{#with slideout.info}}
					<h3>{{#if img}}<img src="{{img}}" alt="">{{/if}} {{nome}}</h3>
					<button type="button" class="cf-primario cf-escolher" data-action="confirmarSlideout" data-valor="{{valor}}" {{#if bloqueado}}disabled title="Pré-requisito não atendido"{{/if}}>
						<i class="fa-solid fa-check"></i> {{#if rotuloEscolher}}{{rotuloEscolher}}{{else}}{{#if jaEscolhido}}Manter{{else}}Escolher{{/if}}{{/if}} {{nome}}
					</button>
					{{#if stats.length}}
					<dl class="cf-dados">{{#each stats}}<dt>{{rotulo}}</dt><dd>{{valor}}</dd>{{/each}}</dl>
					{{/if}}
					{{#each avisos}}<p class="cf-aviso"><i class="fa-solid fa-circle-exclamation"></i> Confira com o mestre: “{{this}}” (não foi possível verificar na ficha).</p>{{/each}}
					{{#if descricao}}<div class="cf-descricao">{{{descricao}}}</div>{{/if}}
					{{> "modules/t20-construtor-ficha/templates/partes/aprimoramentos.hbs" this}}
					{{else}}
					<p class="cf-vazio">Clique em uma opção para ver os detalhes.</p>
					{{/with}}
				</aside>
			</div>
			{{/if}}
		</div>
		{{/if}}
	</section>
</div>
{{/if}}
